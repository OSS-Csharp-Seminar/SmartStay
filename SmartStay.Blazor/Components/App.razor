@* @rendermode InteractiveServer *@
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="SmartStay.Blazor.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(prerender:false))" /> @*M.G: fix for "JavaScript interop calls cannot be issued during static rendering"*@
</head>

<body>
<Routes @rendermode="@(new InteractiveServerRenderMode(prerender:false))" />

<script src="_framework/blazor.web.js"></script>

<script>//M.G: functions for cookies
    window.setCookie = function(name, value, minutes) {
        const expires = new Date(Date.now() + minutes * 60000).toUTCString();
        document.cookie = `${name}=${value}; expires=${expires}; path=/; SameSite=Strict`;
    }
    window.deleteCookie = function(name) {
        document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`;
    }
    window.getCookie = function(name) {
        const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
        return match ? match[2] : null;
    }
</script>
</body>

</html>
