@page "/signin"
@using System.Diagnostics
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Components.Authorization
@using SmartStay.Application
@using SmartStay.Application.Dto.UserDto
@using SmartStay.Application.Interfaces
@using SmartStay.Blazor.Components.Layout
@using SmartStay.Domain.Enums
@layout AuthenticaitonLayout
@inject IAuthenticationService AuthenticationService
@inject ICustomAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Sign Up</PageTitle>

<div class="p-4 rounded-3 text-white container-md" style="background-color:rgb(5, 39, 103); text-align: center">
    <h1>Sign Up</h1>
</div>

<EditForm Model="signupDto" OnSubmit="HandleSignup" FormName="signupForm" class="p-4 rounded-3 text-white container-md d-flex justify-content-center" style="background-color:rgb(5, 39, 103)">
    <ValidationSummary />
    
    <div class="row g-3">
        <div class="col">
            First Name<br/>
            <InputText type="text" class="form-control" @bind-Value="signupDto.FirstName"/>
        </div>
        <div class="col">
            Last Name<br/>
            <InputText  type="text" class="form-control" @bind-Value="signupDto.LastName"/>
        </div>
        <div class="col-12">
            Email<br/>
            <InputText type="email" class="form-control" @bind-Value="signupDto.Email"/>
        </div>
        <div class="col-12">
            Password<br/>
            <InputText type="password" class="form-control" @bind-Value="signupDto.Password" @oninput="e => signupDto.Password = e.Value?.ToString() ?? string.Empty"/>
            <ul class="mt-1" style="list-style:none; padding:0; font-size:0.85rem;">
                <li style="color: @C(signupDto.Password.Length >= 8)">
                    @(signupDto.Password.Length >= 8 ? "✓" : "✗") At least 8 characters
                </li>
                <li style="color: @C(signupDto.Password.Any(char.IsUpper))">
                    @(signupDto.Password.Any(char.IsUpper) ? "✓" : "✗") Uppercase letter (A-Z)
                </li>
                <li style="color: @C(signupDto.Password.Any(char.IsLower))">
                    @(signupDto.Password.Any(char.IsLower) ? "✓" : "✗") Lowercase letter (a-z)
                </li>
                <li style="color: @C(signupDto.Password.Any(char.IsDigit))">
                    @(signupDto.Password.Any(char.IsDigit) ? "✓" : "✗") Number (0-9)
                </li>
                <li style="color: @C(signupDto.Password.Any(c => !char.IsLetterOrDigit(c)))">
                    @(signupDto.Password.Any(c => !char.IsLetterOrDigit(c)) ? "✓" : "✗") Special character (!@@#...)
                </li>
            </ul>
        </div>
        <div class="col-12">
            Confirm Password<br/>
            <InputText type="password" class="form-control" @bind-Value="signupDto.ConfirmPassword"/>
        </div>
        <div class="col-12">
            <label class="form-label">Role</label>
            <InputSelect class="form-control" @bind-Value="signupDto.Role">
                <option value="@Role.Guest">Guest</option>
                <option value="@Role.Renter">Renter</option>
            </InputSelect>
        </div>
    </div>
    <button type="submit" class="mt-3">Sign Up</button>
</EditForm>

<div class="p-4 rounded-3 text-white container-md" style="background-color:rgb(5, 39, 103); text-align: center">
    Already have an account?
    <a href="/login">
        <button>Login</button>
    </a>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-danger">@message</div>
}

@code {
    private SignupDto signupDto {get; set; } = new();

    private class SignupDto
    {
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
        public Role Role { get; set; } = Role.Guest;
    }

    private string message= "";

    private string C(bool ok) => ok ? "lightgreen" : "salmon";

    private bool IsPasswordValid(string pwd) =>
        pwd.Length >= 8 &&
        pwd.Any(char.IsUpper) &&
        pwd.Any(char.IsLower) &&
        pwd.Any(char.IsDigit) &&
        pwd.Any(c => !char.IsLetterOrDigit(c));

    private async Task HandleSignup()
    {
        if (!IsPasswordValid(signupDto.Password))
        {
            message = "Password does not meet the requirements.";
            return;
        }

        if (signupDto.Password != signupDto.ConfirmPassword)
        {
            message= "Passwords do not match";
            return;
        }

        try
        {
            var dto = new UserCreationRequestDto(
                signupDto.Email,
                signupDto.Password,
                signupDto.FirstName,
                signupDto.LastName,
                    signupDto.Role
            );
            
            Debug.WriteLine("D-email: "+signupDto.Email);
            var response=await AuthenticationService.CreateUser(dto);
            
            // await LocalStorage.SetItemAsync("id", response.UserId);
            
            HttpContextAccessor.HttpContext?.Response.Cookies.Append(
                "id"
                ,response.UserId.ToString()
                ,new CookieOptions{SameSite=SameSiteMode.Strict, Expires = DateTime.UtcNow.AddMinutes(120)});

            await AuthenticationStateProvider.NotifyUserAuthenticationAsync(response.Token);

            
            message= "Account created successfully!";
            
            Nav.NavigateTo("/dashboard");
        }
        catch (Exception e)
        {
            Debug.WriteLine("Error: " + e.Message);
            message = "Registration failed. Please try again.";
        }

    }
}