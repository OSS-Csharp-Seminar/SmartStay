@page "/login"

@using System.Diagnostics
@using Blazored.LocalStorage
@using SmartStay.Application
@using SmartStay.Application.Dto.UserDto
@using SmartStay.Application.Interfaces
@using SmartStay.Blazor.Components.Layout
@layout AuthenticaitonLayout
@inject IAuthenticationService AuthenticationService
@inject ICustomAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Login</PageTitle>

<div class="p-4 rounded-3 text-white container-md" style="background-color:rgb(5, 39, 103); text-align: center">
    <h1>Login</h1>
</div>

<EditForm Model="@loginModel" OnSubmit="HandleLogin" FormName="loginForm" class="p-4 rounded-3 text-white container-md d-flex justify-content-center" style="background-color:rgb(5, 39, 103)">
    <div class="row g-3">
        <div class="col">
            email<br/>
            <InputText type="email" class="form-control" @bind-value="loginModel.email"/>
        </div>
        <div class="col">
            password<br/>
            <InputText  type="password" class="form-control" @bind-value="loginModel.password"/>
        </div>
    </div>
    <button type="submit" >Login</button>
</EditForm>

<div class="p-4 rounded-3 text-white container-md" style="background-color:rgb(5, 39, 103); text-align: center">
    Don't have an account? 
    <a href="/signin">
        <button>Signin</button>
    </a>
    <br>
    <br>
    <a href="/password-recovery">
        <button>Forgot password?</button>
    </a>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

@code
{
    private LoginModel loginModel = new();

    private class LoginModel
    {
        public string password { get; set; } = "";
        public string email { get; set; } = "";
    }

    private string error="";
    
    private async Task HandleLogin()
    {
        var dto = new UserLoginRequestDto( loginModel.email,loginModel.password);

        AuthenticationResponseDto response ;
        
        try{
            response = await AuthenticationService.Authenticate(dto);
            
            //M.G: Not secure but simple(vulnerable to xss attack). cant add it to httponly cookie cause there is no web api.
            await JS.InvokeVoidAsync("setCookie", "id", response.UserId.ToString(), 120);
            await AuthenticationStateProvider.NotifyUserAuthenticationAsync(response.Token);
                    
            error="Login successful!";
        }
        catch (Exception e)
        {
            Debug.WriteLine("Error: "+e.Message);
            error="Invalid email or password.";
            return;
        }

        Nav.NavigateTo("/dashboard");
    }
    
}
