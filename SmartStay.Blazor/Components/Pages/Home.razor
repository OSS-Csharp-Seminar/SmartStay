@page "/dashboard"
@page "/"

@using SmartStay.Application.Dto.RoomDto
@using SmartStay.Application.Interfaces
@using SmartStay.Domain.Dto
@using Microsoft.AspNetCore.Components.Authorization

@inject IRoomService RoomService
@inject NavigationManager Nav

<div class="p-5 rounded-3 text-white text-center mb-4" style="background-color:rgb(5, 39, 103);">
    <h1 class="fw-bold">New Apartments</h1>
    <p class="text-white-50 mb-0">Fresh stays added by hosts across the map.</p>
</div>

<div class="container-md">
    @if (rooms == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!rooms.Any())
    {
        <div class="text-center py-5">
            <p class="fs-5 mb-1">No stays found at the moment.</p>
            <p class="text-muted">Try widening your dates or clearing a filter.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var room in rooms)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">@room.Name</h5>
                                <span class="badge bg-warning text-dark">★ @room.AverageRating.ToString("0.0")</span>
                            </div>

                            <p class="text-muted mb-1">
                                <i class="bi bi-geo-alt"></i> @room.Location.City, @room.Location.Country
                            </p>
                            <p class="text-muted mb-2">
                                <i class="bi bi-people"></i> @room.Capacity guests
                            </p>

                            @if (room.Amenities != null && room.Amenities.Any())
                            {
                                <div class="mb-3">
                                    @foreach (var amenity in room.Amenities.Take(3))
                                    {
                                        <span class="badge bg-light text-dark border me-1">@amenity</span>
                                    }
                                    @if (room.Amenities.Count() > 3)
                                    {
                                        <span class="badge bg-light text-dark border">+@(room.Amenities.Count() - 3) more</span>
                                    }
                                </div>
                            }

                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                <span class="fs-5 fw-bold text-success">@room.PricePerNight$ <small class="fs-6 fw-normal text-muted">/night</small></span>
                                <button class="btn btn-primary btn-sm" @onclick="() => NavigateToRoom(room.Id)">View Details</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {//M.G: reused from Apartaments.razor
    public class Qry
    {
        public string Page { get; set; } = "1";
        public string PageSize{get; set;}="10";
        public string? Name { get; set; } 
        public string? PriceLowerRange{get; set;}
        public string? PriceUpperRange{get; set;}
        public string? GuestNumber{get; set;}
        public List<string>? Amenities{get; set;}
        public string? Rating{get; set;}
        public string? FreeFrom{get; set;}
        public string? FreeTo{get; set;}
        public string? City {get; set;}
        public string? SortBy { get; set; } = "date";
        public string? IsDescending { get; set; } = "true";
    };



    private Qry searchDto = new();
    private IEnumerable<RoomResponseDto>? rooms;
    private string message = null;

    protected async override Task OnInitializedAsync()
    {
        try
        {
            if(searchDto is { PriceLowerRange: not null, PriceUpperRange: not null })
                if (float.Parse(searchDto.PriceLowerRange) < 0 
                    || float.Parse(searchDto.PriceLowerRange) > float.Parse(searchDto.PriceUpperRange)
                    || float.Parse(searchDto.PriceUpperRange) < 0)
                {
                    throw new Exception("Invalid price range");
                }


            var queri = new RoomQueryDto(
                uint.Parse(searchDto.Page),
                uint.Parse(searchDto.PageSize),
                searchDto.Name,
                string.IsNullOrEmpty(searchDto.PriceLowerRange) ? null : float.Parse(searchDto.PriceLowerRange),
                string.IsNullOrEmpty(searchDto.PriceUpperRange) ? null : float.Parse(searchDto.PriceUpperRange),
                string.IsNullOrEmpty(searchDto.GuestNumber) ? null : uint.Parse(searchDto.GuestNumber) ,
                searchDto.Amenities,
                string.IsNullOrEmpty(searchDto.Rating) ? null : float.Parse(searchDto.Rating) ,
                string.IsNullOrEmpty(searchDto.FreeFrom) ? null : DateTimeOffset.Parse(searchDto.FreeFrom),
                string.IsNullOrEmpty(searchDto.FreeTo) ? null : DateTimeOffset.Parse(searchDto.FreeTo) ,
                searchDto.City, 
                searchDto.SortBy,
                bool.Parse(searchDto.IsDescending)
            );


            rooms = await RoomService.GetRooms(queri);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error searching rooms: {ex.Message}");
        }
    }
    
    private void NavigateToRoom(Guid RoomId)
    {
        Nav.NavigateTo($"/rooms/{RoomId}");
    }   

}