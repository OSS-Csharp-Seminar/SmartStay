@page "/rooms/{RoomId:guid}"


@using System.Diagnostics
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SmartStay.Application.Dto
@using SmartStay.Application.Dto.BookingDto
@using SmartStay.Application.Dto.RoomDto
@using SmartStay.Application.Interfaces
@using SmartStay.Blazor.Components.Layout

@layout MainLayout
@inject IRoomService RoomService
@inject IReviewService ReviewService
@inject IBookingService BookingService
@inject IJSRuntime JS



<div class="p-4 rounded-3 text-white container-md" style="background-color:rgb(5, 39, 103); text-align: center">
    <h1>@_room?.Name</h1>
    <p class="text-light">
        @_room?.Location.City, @_room?.Location.Country
    </p>
</div>

<div class="container-md mt-4">
    <div class="row g-4">
        
        <div class="col-lg-8">
            @* <div class="card mb-4" style="background-color: rgba(255, 255, 255, 0.1); border: none;"> *@
            @*     <img src="@(room?.MainImageUrl ?? "/images/room-placeholder.jpg")"  *@
            @*          class="card-img-top"  *@
            @*          alt="@room?.Name" *@
            @*          style="height: 450px; object-fit: cover; border-radius: 8px;"> *@
            @* </div> *@
            
            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="alert alert-info mt-4 container-md">@_message</div>
            }
            
            <div class="card p-4 mb-4" style="background-color: rgba(255, 255, 255, 0.1);">
                <h4 class="mb-3">About This Room</h4>
                <p class="text-dark">@_room?.Description</p>
                <hr/>
                <p class="text-dark"><b>Capacity:</b> @_room?.Capacity Guests</p>
                <p class="text-dark"><b>Bed type:</b> @_room?.BedType</p>
            </div>

            <div class="card p-4 mb-4" style="background-color: rgba(255, 255, 255, 0.1);">
                <h4 class="mb-3">Amenities</h4>
                <div class="row g-3">
                    @if (_room?.Amenities != null)
                    {
                        @foreach (var amenity in _room.Amenities)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-success">✔</span>
                                    <span>@amenity</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card sticky-top" style="background-color: rgba(255, 255, 255, 0.1); top: 20px;">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <h3 class="mb-1">@_room?.PricePerNight <small>$ / night</small></h3>
                        <div class="text-warning">
                            Rating (@_room?.AverageRating)
                        </div>
                    </div>

                </div>
                    
                @if (!_IsBookingFormShown)
                {
                    <button @onclick="ShowBookingForm">Book now</button>
                }
                @if (_IsBookingFormShown)
                {
                    //calendar     
                    <div class="container-fluid p-3" style="max-width: 480px;">

                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <button class="btn btn-outline-secondary btn-sm px-3" @onclick="PrevMonth">&#8249;</button>
                            <strong>@_currentDate.ToString("MMMM yyyy")</strong>
                            <button class="btn btn-outline-secondary btn-sm px-3" @onclick="NextMonth">&#8250;</button>
                        </div>

                        <div class="row row-cols-7 g-1 text-center mb-1">
                            @foreach (var day in new[] { "Su","Mo","Tu","We","Th","Fr","Sa" })
                            {
                                <div class="col">
                                    <small class="text-muted fw-semibold">@day</small>
                                </div>
                            }
                        </div>

                        <div class="row row-cols-7 g-1 text-center">
                            @foreach (var cell in GetCalendarCells())
                            {
                                <div class="col">
                                    <button class="btn btn-sm w-100 p-1 position-relative
                                                       @(_markedDates.Contains(cell.Date) ? "btn-primary" : "btn-light")
                                                       @(_occupiedDates.Contains(cell.Date) ? "btn-outline-danger" : "btn-light")
                                                       @(DateOnly.FromDateTime(DateTime.Today) > cell.Date ? "btn-outline-danger" : "btn-light")
                                                       @(cell.IsToday && !_markedDates.Contains(cell.Date) ? "border border-secondary" : "")
                                                       @(!cell.IsCurrentMonth ? "opacity-25" : "")"
                                            @onclick="() => ToggleMark(cell.Date)"
                                            style="aspect-ratio:1; font-size:13px;">
                                        @cell.Date.Day
                                        @if (_markedDates.Contains(cell.Date))
                                        {
                                            <span class="position-absolute bottom-0 start-50 translate-middle-x mb-1
                                                             rounded-circle bg-white"
                                                  style="width:4px;height:4px;display:block;"></span>
                                        }
                                    </button>
                                </div>
                            }
                        </div>
                        
                        
                        @if((_markedDates.Count()-1)>0){
                            <div class="mt-3 px-3 pb-3">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-body">
                                        <h6 class="card-title mb-3">Summary</h6>

                                        <div class="d-flex justify-content-between mb-2">
                                            <span>Price per night</span>
                                            <strong>@_room.PricePerNight$</strong>
                                        </div>

                                        <div class="d-flex justify-content-between mb-2">
                                            <span>Nights</span>
                                            <strong>@(_markedDates.Count()-1)</strong>
                                        </div>

                                        <hr />

                                        <div class="d-flex justify-content-between fs-5">
                                            <span>Total</span>
                                            <strong class="text-success">@_totalPrice$</strong>
                                        </div>
                                    </div>
                                </div>

                                <AuthorizeView>
                                    <Authorized>
                                        <button class="btn btn-success w-100 mt-3" @onclick="BookRoom">
                                            Book now
                                        </button>
                                    </Authorized>
                                    
                                    <NotAuthorized>
                                        <span class="text-danger">You have to be singed in to book!</span>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </div>
                            }
                        
                        
                    
                    </div>
                    //calendar     
                }


            </div>
        </div>
    </div>
</div>

@* M.G: google maps *@
<iframe
    width="600" height="450"
    style="border:0"
    loading="lazy"
    src="https://www.google.com/maps?q=@(_room.Location.Latitude),@(_room.Location.Longitude)&z=14&output=embed">
</iframe>

<div class="container-md mt-5">
    <div class="card p-4" style="background-color: rgba(255, 255, 255, 0.1);">
        <h4 class="mb-4">Guest Reviews</h4>
        @if (_reviews != null && _reviews.Any())
        {
            @foreach (var review in _reviews)
            {
                <div class="border-bottom border-light border-opacity-25 pb-4 mb-4">
                    <div class="d-flex justify-content-between">
                        <strong>@review.UserName</strong>
                        <span class="text-warning"><b>Rating:</b> @review.Rating★</span>
                    </div>
                    <p class="mt-2 text-dark">@review.Comment</p>
                <small class="text-light-emphasis"><b>On day:</b> @review.DateCreated.LocalDateTime</small>
                </div>
            }
        }
        else
        {
            <p class="text-dark">No reviews yet. Be the first to review this room!</p>
        }
    </div>
</div>



@code {

    private bool _IsBookingFormShown = false;
    [Parameter] public Guid RoomId { get; set; }
    private RoomResponseDto? _room;
    private IEnumerable<ReviewResponseDto>? _reviews;
    private IEnumerable<RoomAvailabilityDto>? _occupiedRooms;
    private DateTime _currentDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private HashSet<DateOnly> _markedDates = new();
    private List<DateOnly>? _occupiedDates;
    private string _message = null;
    private float _totalPrice = 0;
    
    
    protected async override Task OnInitializedAsync()
    {
        _reviews = await ReviewService.GetAllByRoomIdAsync(RoomId);
        _room = await RoomService.GetRoomById(RoomId);
        _occupiedRooms= await BookingService.GetOccupiedRooms(RoomId);
        _occupiedDates =OccupiedRoomsTypeConverter() ?? null; 
    }

    public void ShowBookingForm()
    {
        _IsBookingFormShown = true;
    }


    private List<DateOnly> OccupiedRoomsTypeConverter()
    {
        //M.G: SelectMany flattens nested lists
         return _occupiedRooms.SelectMany(r =>
            {
                var checkIn =DateOnly.FromDateTime(r.CheckIn.LocalDateTime);
                var checkOut =DateOnly.FromDateTime(r.CheckOut.LocalDateTime);

                var nights = checkOut.DayNumber - checkIn.DayNumber;
                Debug.WriteLine("nights: "+nights);

                return Enumerable.Range(0, nights)
                    .Select(i => checkIn.AddDays(i));
            }
        ).ToList();
    }

    private async Task BookRoom()
    {
        var Userid = await JS.InvokeAsync<Guid>("getCookie","id"); 


        var Checkin = new DateTimeOffset(_markedDates.Min().ToDateTime(TimeOnly.MinValue), TimeSpan.Zero);
        var CheckOut = new DateTimeOffset(_markedDates.Max().ToDateTime(TimeOnly.MaxValue), TimeSpan.Zero);

        var dto = new CreateBookingRequestDto(Userid, RoomId, Checkin, CheckOut);
        
        try{
            await BookingService.CreateBookingAsync(dto);
            _message = "Room booked.";
            StateHasChanged(); 
        }
        catch
        {
            _message = "Error: unable to book room!";
        }
    }

    
    //calendar
    void PrevMonth() => _currentDate = _currentDate.AddMonths(-1);
    void NextMonth() => _currentDate = _currentDate.AddMonths(1);

    void ToggleMark(DateOnly date)
    {
        
        if (_markedDates.Count > 2)//M.G: third click on date resets choosen date list for easier date picking.
        {
            _markedDates.Clear();
            _totalPrice = 0;
        }
        
        
        if (!_markedDates.Remove(date)
            && !_occupiedDates.Contains(date) 
            && date > DateOnly.FromDateTime(DateTime.Today))
            
            _markedDates.Add(date);
        

        if (_markedDates.Count() > 1)//M.G: adds missing dates between smallest and biggest choosen date
        {
            var smallestDate = _markedDates.Min();
            
            var BiggestDate = _markedDates.Max();

            int i = 1;

            while(true)
            {
                if (smallestDate.AddDays(i) == BiggestDate)
                     break;

                _markedDates.Add(smallestDate.AddDays(i));
                i++;
            }
            

            if (_markedDates.Any(d => _occupiedDates.Contains(d)))
            {
                _markedDates.Clear();
                _message = "Date you choose is already occupied!";
            }
            
            _totalPrice = ((_markedDates.Count()-1) * _room.PricePerNight);
        }
    }

    List<CalCell> GetCalendarCells()
    {
        var cells = new List<CalCell>();
        var first = new DateTime(_currentDate.Year, _currentDate.Month, 1);
        var daysInMonth = DateTime.DaysInMonth(_currentDate.Year, _currentDate.Month);

        for (int i = 0; i < (int)first.DayOfWeek; i++)
        {
            var d = first.AddDays(-(first.DayOfWeek - (DayOfWeek)i));
            cells.Add(new CalCell(DateOnly.FromDateTime(d), false));
        }

        for (int d = 1; d <= daysInMonth; d++)
            cells.Add(new CalCell(new DateOnly(_currentDate.Year, _currentDate.Month, d), true));

        int trailing = 7 - (cells.Count % 7);
        if (trailing < 7)
        {
            var last = cells.Last().Date;
            for (int i = 1; i <= trailing; i++)
                cells.Add(new CalCell(last.AddDays(i), false));
        }

        return cells;
    }

    record CalCell(DateOnly Date, bool IsCurrentMonth)
    {
        public bool IsToday => Date == DateOnly.FromDateTime(DateTime.Today);
    }
//calendar
    
}
