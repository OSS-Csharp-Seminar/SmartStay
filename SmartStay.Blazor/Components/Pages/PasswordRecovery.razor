@page "/password-recovery"
@using SmartStay.Application.Interfaces
@using SmartStay.Blazor.Components.Layout
@layout AuthenticaitonLayout
@inject IPasswordRecoveryService PasswordRecoveryService
@inject NavigationManager Nav

<PageTitle>Forgot Password</PageTitle>

<div class="p-4 rounded-3 text-white container-md" style="background-color:rgb(5, 39, 103); text-align: center">
    <h1>Forgot Password</h1>
</div>

<div class="p-4 rounded-3 text-white container-md" style="background-color:rgb(5, 39, 103)">

    @if (step == 1)
    {
        <p>Enter your email address and we'll send you a reset code.</p>
        <div class="mb-3">
            Email<br />
            <input type="email" class="form-control" @bind="email" />
        </div>
        <button class="mt-2" @onclick="HandleSendCode" disabled="@isLoading">
            @(isLoading ? "Sending..." : "Send Code")
        </button>
    }

    @if (step == 2)
    {
        <p>Enter the 6-digit code sent to <strong>@email</strong>.</p>
        <div class="mb-3">
            Code<br />
            <input type="text" class="form-control" maxlength="6" @bind="code" />
        </div>
        <button class="mt-2" @onclick="HandleVerifyCode">Verify Code</button>
    }

    @if (step == 3)
    {
        <p>Enter your new password.</p>
        <div class="mb-3">
            New Password<br />
            <input type="password" class="form-control" @bind="newPassword" @oninput="e => newPassword = e.Value?.ToString() ?? string.Empty" />
            <ul class="mt-1" style="list-style:none; padding:0; font-size:0.85rem;">
                <li style="color: @C(newPassword.Length >= 8)">
                    @(newPassword.Length >= 8 ? "✓" : "✗") At least 8 characters
                </li>
                <li style="color: @C(newPassword.Any(char.IsUpper))">
                    @(newPassword.Any(char.IsUpper) ? "✓" : "✗") Uppercase letter (A-Z)
                </li>
                <li style="color: @C(newPassword.Any(char.IsLower))">
                    @(newPassword.Any(char.IsLower) ? "✓" : "✗") Lowercase letter (a-z)
                </li>
                <li style="color: @C(newPassword.Any(char.IsDigit))">
                    @(newPassword.Any(char.IsDigit) ? "✓" : "✗") Number (0-9)
                </li>
                <li style="color: @C(newPassword.Any(c => !char.IsLetterOrDigit(c)))">
                    @(newPassword.Any(c => !char.IsLetterOrDigit(c)) ? "✓" : "✗") Special character (!@@#...)
                </li>
            </ul>
        </div>
        <div class="mb-3">
            Confirm New Password<br />
            <input type="password" class="form-control" @bind="confirmPassword" />
        </div>
        <button class="mt-2" @onclick="HandleResetPassword">Reset Password</button>
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="mt-3 alert @messageClass">@message</div>
    }
</div>

<div class="p-4 rounded-3 text-white container-md" style="background-color:rgb(5, 39, 103); text-align: center">
    <a href="/login"><button>Back to Login</button></a>
</div>

@code {
    private int step = 1;
    private string email = "";
    private string code = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private string message = "";
    private string messageClass = "alert-danger";
    private bool isLoading = false;

    private async Task HandleSendCode()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            message = "Please enter your email address.";
            return;
        }

        isLoading = true;
        message = "";

        try
        {
            await PasswordRecoveryService.SendResetCodeAsync(email);
            messageClass = "alert-success";
            message = "If an account with that email exists, a code has been sent.";
            step = 2;
        }
        catch (Exception ex)
        {
            messageClass = "alert-danger";
            message = $"Failed to send email: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleVerifyCode()
    {
        if (string.IsNullOrWhiteSpace(code))
        {
            messageClass = "alert-danger";
            message = "Please enter the code.";
            return;
        }

        var valid = await PasswordRecoveryService.VerifyCodeAsync(email, code);
        if (!valid)
        {
            messageClass = "alert-danger";
            message = "Invalid or expired code. Please try again.";
            return;
        }

        message = "";
        step = 3;
    }

    private string C(bool ok) => ok ? "lightgreen" : "salmon";

    private bool IsPasswordValid(string pwd) =>
        pwd.Length >= 8 &&
        pwd.Any(char.IsUpper) &&
        pwd.Any(char.IsLower) &&
        pwd.Any(char.IsDigit) &&
        pwd.Any(c => !char.IsLetterOrDigit(c));

    private async Task HandleResetPassword()
    {
        if (string.IsNullOrWhiteSpace(newPassword))
        {
            messageClass = "alert-danger";
            message = "Please enter a new password.";
            return;
        }

        if (!IsPasswordValid(newPassword))
        {
            messageClass = "alert-danger";
            message = "Password does not meet the requirements.";
            return;
        }

        if (newPassword != confirmPassword)
        {
            messageClass = "alert-danger";
            message = "Passwords do not match.";
            return;
        }

        await PasswordRecoveryService.ResetPasswordAsync(email, newPassword);

        messageClass = "alert-success";
        message = "Password changed successfully! Redirecting to login...";
        await Task.Delay(2000);
        Nav.NavigateTo("/login");
    }
}
