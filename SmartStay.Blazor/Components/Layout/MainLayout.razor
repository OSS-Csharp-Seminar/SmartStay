@using System.Diagnostics
@using Blazored.LocalStorage
@using SmartStay.Application.Interfaces
@inherits LayoutComponentBase
@inject ICustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>


        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {//M.G: [Authorize] attribute is wierd (doesn't work) without httponly cookie so I made manual authentication until i find work around.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // var token = await LocalStorage.GetItemAsync<string>("token");
            var token = await JS.InvokeAsync<string>("getCookie", "token");
            
            if (string.IsNullOrEmpty(token))
            {
                Nav.NavigateTo("/login");
                return;
            }
            
            await AuthStateProvider.NotifyUserAuthenticationAsync(token);
            StateHasChanged();
        }
    }
}